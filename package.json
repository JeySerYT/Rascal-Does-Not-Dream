{
    "name": "rascal-does-not-dream",
    "themeName": "Rascal Does Not Dream",
    "description": "Mai Sakurajima Theme for PulseSync",
    "author": "JeySerYT",
    "scripts": {
        "build": "ymtm build pulsesync && powershell -ExecutionPolicy Bypass -File build-with-license.ps1"
    },
    "build": {
        "package": [
            "pulsesync"
        ]
    },
    "pulsesync": {
        "zip": {
            "artifactName": "Rascal-Does-Not-Dream_${theme.version}_${build.package}.zip"
        },
        "pext": {
            "artifactName": "Rascal-Does-Not-Dream_${theme.version}_${build.package}.pext"
        }
    },
    "dependencies": {
        "ymtm": "github:Diramix/ymtm#3.0.1"
    }
}